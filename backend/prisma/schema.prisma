datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Transaction {
  id          BigInt   @id @default(autoincrement())
  type        String   @db.VarChar(10) // "EXPENSE" | "INCOME"
  amount      Decimal  @db.Decimal(15, 2)
  category    String   @db.VarChar(50)
  class       String   @db.VarChar(10) // "Needs" | "Wants"
  description String?  @db.Text
  isMicroLeak Boolean  @default(false) @map("is_micro_leak")
  rawMessage  String?  @map("raw_message") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([createdAt], map: "idx_transactions_created_at")
  @@index([category], map: "idx_transactions_category")
  @@map("transactions")
}

model UserRule {
  id        Int      @id @default(autoincrement())
  ruleText  String   @map("rule_text") @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("user_rules")
}
