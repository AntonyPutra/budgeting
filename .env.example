# Server Configuration
PORT=3000
NODE_ENV=development
TZ=Asia/Jakarta

# Google Gemini API
# Dapatkan API key di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"
# Production Homelab (PostgreSQL Docker):
# DATABASE_URL="postgresql://finbot:finbot_homelab_secret@localhost:5432/monthlybudget?schema=public"

# Database Credentials untuk docker-compose
POSTGRES_USER=finbot
POSTGRES_PASSWORD=finbot_homelab_secret
POSTGRES_DB=monthlybudget

# Evolution API (WhatsApp Gateway di Server Homelab)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_global_key
EVOLUTION_INSTANCE_NAME=finbot
TONYY_WHATSAPP_NUMBER=6281234567890

# WhatsApp Webhook Security Token (opsional)
WEBHOOK_SECRET=your_secret_webhook_token
